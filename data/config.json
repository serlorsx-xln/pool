{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "initial_pool_size": 200,
    "drop_excess_requests": false,
    "enable_logging": true,
    "log_retention_days": 30
  },
  "providers": {
    "upstream-pool": {
      "keys": [
        {
          "name": "serlorsx-key",
          "value": "env.UPSTREAM_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "text_completion": true,
          "text_completion_stream": true,
          "embedding": true
        }
      }
    },
    "niceday-pool": {
      "keys": [
        {
          "name": "niceday-key",
          "value": "env.NICEDAY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "text_completion": true,
          "text_completion_stream": true,
          "embedding": true
        }
      }
    },
    "upstream-anthropic": {
      "keys": [
        {
          "name": "serlorsx-anthropic-key",
          "value": "env.UPSTREAM_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol/anthropic",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        }
      }
    },
    "niceday-anthropic": {
      "keys": [
        {
          "name": "niceday-anthropic-key",
          "value": "env.NICEDAY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol/anthropic",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        }
      }
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "redis",
    "config": {
      "addr": "redis:6379",
      "db": 0
    }
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "dimension": 1,
        "ttl": 300,
        "cache_by_model": true,
        "cache_by_provider": true,
        "conversation_history_threshold": 3
      }
    }
  ],
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/db/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/db/logs.db"
    }
  }
}
