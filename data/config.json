{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "initial_pool_size": 200,
    "drop_excess_requests": false,
    "enable_logging": true,
    "log_retention_days": 30
  },
  "providers": {
    "upstream-pool": {
      "keys": [
        {
          "name": "serlorsx-key",
          "value": "env.UPSTREAM_API_KEY",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "niceday-key",
          "value": "env.NICEDAY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "text_completion": true,
          "text_completion_stream": true,
          "embedding": true
        }
      }
    },
    "upstream-anthropic": {
      "keys": [
        {
          "name": "serlorsx-anthropic-key",
          "value": "env.UPSTREAM_API_KEY",
          "models": ["*"],
          "weight": 1.0
        },
        {
          "name": "niceday-anthropic-key",
          "value": "env.NICEDAY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://anutinaiplus.catkiller.lol/anthropic",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        }
      }
    }
  },
  "auth_config": {
    "admin_username": "serlorsx",
    "admin_password": "env.BIFROST_ADMIN_PASSWORD",
    "is_enabled": true,
    "disable_auth_on_inference": true
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-serlorsx",
        "value": "sk-bf-5dc3870e-27d1-42e3-bedb-ce4b4fad54cd",
        "name": "serlorsx",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "upstream-pool",
            "key_ids": ["serlorsx-key"],
            "allowed_models": ["*"],
            "weight": 1.0
          },
          {
            "provider": "upstream-anthropic",
            "key_ids": ["serlorsx-anthropic-key"],
            "allowed_models": ["*"],
            "weight": 1.0
          }
        ]
      },
      {
        "id": "vk-niceday",
        "value": "sk-bf-f5254110-dbba-40f0-8790-c15c4a6d3317",
        "name": "niceday",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "upstream-pool",
            "key_ids": ["niceday-key"],
            "allowed_models": ["*"],
            "weight": 1.0
          },
          {
            "provider": "upstream-anthropic",
            "key_ids": ["niceday-anthropic-key"],
            "allowed_models": ["*"],
            "weight": 1.0
          }
        ]
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/db/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/db/logs.db"
    }
  }
}
